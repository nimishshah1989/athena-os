  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-no-hardcoded-creds.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-no-bare-except.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-design-gate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-no-float-money.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-no-pii-logging.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-decimal-encoder-fastapi.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-edit-require-thinking.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_supabase_supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/pre-supabase-sql-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-scan-encoder.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-edit-pyright.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-edit-eslint.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-edit-pragma-test-required.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-skill-thinking-marker.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_supabase_supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/post-supabase-sql-consume.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "aislop hook claude"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-task-cost-snapshot.sh"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".aislop/config.yml|.aislop/rules.yml|package.json",
        "hooks": [
          {
            "type": "command",
            "command": "aislop hook claude --on-file-changed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "aislop hook claude --stop"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "superpowers@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
